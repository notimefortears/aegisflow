# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST
.eggs/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.xml
.tox/
nosetests.xml

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
.pnp
.pnp.js

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.yarn/unplugged
.pnpm-debug.log*

# ── Alembic ───────────────────────────────────────────────────────────────────
# Keep migrations tracked; ignore only generated temp files
alembic/versions/*.pyc

# ── Docker ────────────────────────────────────────────────────────────────────
# Ignore the real .env but NOT .env.example
.env
.env.local
.env.*.local
!.env.example

# ── Secrets & credentials ─────────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
secrets/
nginx/ssl/

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDEs & editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
.cache/
